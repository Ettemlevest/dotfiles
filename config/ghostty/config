# Font
font-family = Hack Nerd Font
font-size = 13

# Theme (run `ghostty +list-themes` to browse)
theme = Monokai Soda

# Shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Cursor
cursor-style = block

# Window
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = transparent

# Clipboard
copy-on-select = clipboard
